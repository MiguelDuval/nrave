<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NRaveTheme" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <!-- Pre-Android 12 window: stay neutral until Qt presents the NRave QML splash. -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>

        <!-- Android 12+: use the NRave launcher artwork for the system starting window. -->
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/nrave_splash_transparent_icon</item>
    </style>
</resources>
